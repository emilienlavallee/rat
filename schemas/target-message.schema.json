{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "target-message.schema.json",
  "title": "Target Message",
  "description": "Messages passed between the controller and the target",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "set-horizontal-servo"
        },
        "angle": {
          "type": "integer",
          "minimum": 0,
          "maximum": 180
        }
      },
      "required": [
        "kind",
        "angle"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "set-vertical-servo"
        },
        "angle": {
          "type": "integer",
          "minimum": 0,
          "maximum": 180
        }
      },
      "required": [
        "kind",
        "angle"
      ],
      "additionalProperties": false
    }
  ]
}
